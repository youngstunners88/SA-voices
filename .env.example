# HuggingFace Configuration
HUGGINGFACE_API_KEY=hf_your_key_here
HUGGINGFACE_CACHE_DIR=./models/cache

# Qwen3-TTS Configuration
QWEN_TTS_MODEL=Qwen/Qwen3-TTS
QWEN_TTS_DEVICE=auto
QWEN_TTS_PRECISION=fp16

# WaxalNLP Dataset
WAXAL_DATASET=google/WaxalNLP
WAXAL_CACHE_DIR=./data/waxal

# Audio Configuration
AUDIO_SAMPLE_RATE=24000
AUDIO_FORMAT=wav
AUDIO_CHUNK_SIZE=1024

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=false

# State Management
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./data/sa_voices.db
SESSION_TIMEOUT=3600

# Language Configuration
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=af,en,nr,nso,st,ss,tn,ts,ve,xh,zu
LANGUAGE_DETECTION_CONFIDENCE=0.8

# Voice Processing
VOICE_CLONING_ENABLED=true
MAX_AUDIO_LENGTH=300
MIN_AUDIO_LENGTH=1

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/sa_voices.log

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
